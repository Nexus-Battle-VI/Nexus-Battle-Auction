# Configuracion del servicio Auction.
# Se copia a `.env` para desarrollo local. `.env` esta ignorado por Git.
# Este archivo no contiene ni debe contener secretos reales.

# --- Servicio -------------------------------------------------------------
NODE_ENV=development
SERVICE_NAME=nexus-battle-auction
SERVICE_VERSION=0.1.0
LOG_LEVEL=info
PORT=3008
GLOBAL_PREFIX=api

# Documentacion interactiva OpenAPI en /api/docs.
SWAGGER_ENABLED=true

# --- Persistencia ---------------------------------------------------------
# memory: doble en proceso para desarrollo y pruebas.
# postgres: PostgreSQL real; exige DATABASE_URL.
PERSISTENCE_DRIVER=memory
DATABASE_URL=

# --- Autenticacion --------------------------------------------------------
# disabled: solo desarrollo/pruebas.
# jwt: exige testimonio de acceso firmado por Cognito.
AUTH_MODE=disabled

COGNITO_USER_POOL_ID=us-east-1_HrEiSzzKW
COGNITO_CLIENT_ID=vqtjlpsemjr5kjtsb97fnr1qp

# `sub` inmutable de la identidad UPB-COMPANY. El rol GAME_MASTER por si solo
# no autoriza publicaciones oficiales; ambos valores deben coincidir.
GAME_MASTER_SUBJECT=

# --- Contrato interno entre servicios -------------------------------------
# Secreto HMAC compartido para `/api/internal/v1/...`. Sin el, las rutas
# internas responden 503. Consumidores autorizados (ADR-019): ninguno todavía.
INTERNAL_SERVICE_AUTH_SECRET=

# Catalog.
CATALOG_BASE_URL=http://catalog:3003

# --- HU-63.5: notificacion al postor superado -----------------------------
# URL del servidor interno que agregamos en Nexus-Battle-Notifications.
#
# En Docker normalmente sera algo equivalente a:
# http://notifications:3005
#
# Se deja vacio por defecto para que desarrollo local sin Notifications
# utilice el adaptador fail-closed.
NOTIFICATIONS_BASE_URL=

# Timeout de la llamada Auction -> Notifications.
NOTIFICATIONS_TIMEOUT_MS=3000

# --- HU-65: Wallet interno -----------------------------------------------
# Se deja vacio para desarrollo local sin Wallet; requiere el secreto interno.
WALLET_BASE_URL=
WALLET_REQUEST_TIMEOUT_MS=3000

# --- HU-65: Player-Inventory interno -------------------------------------
# Se deja vacio para desarrollo local sin Player-Inventory; requiere el secreto interno.
INVENTORY_BASE_URL=
INVENTORY_REQUEST_TIMEOUT_MS=3000

# --- HU-62: Account interno (sanciones del vendedor) ----------------------
# Se deja vacio para desarrollo local sin Account; requiere el secreto interno.
# Sin configurar, publicar una subasta falla cerrado (UnavailableSellerSanctions).
ACCOUNT_BASE_URL=
ACCOUNT_REQUEST_TIMEOUT_MS=3000

# --- HU-65.5: worker invocable de settlement -----------------------------
# El scheduler periodico se incorpora en un bloque posterior. El lease de
# cinco minutos permite recuperar trabajo tras un restart; SettleAuction sigue
# siendo la barrera idempotente secundaria si una ejecucion supera el lease.
AUCTION_SETTLEMENT_SCHEDULER_ENABLED=false
AUCTION_SETTLEMENT_POLL_INTERVAL_MS=5000
AUCTION_SETTLEMENT_BATCH_SIZE=25
AUCTION_SETTLEMENT_CONCURRENCY=4
AUCTION_SETTLEMENT_LEASE_MS=300000
AUCTION_SETTLEMENT_RETRY_DELAY_MS=30000

# --- HU-65.6: despacho durable de auction.settled.v1 ---------------------
# Desactivado por defecto: settlement y outbox siguen funcionando sin SQS.
AUCTION_SETTLEMENT_EVENT_DISPATCH_ENABLED=false
AUCTION_SETTLEMENT_QUEUE_URL=
AUCTION_SETTLEMENT_EVENT_DISPATCH_BATCH_SIZE=25

# --- HU-69.6: vencimiento definitivo de pending-claims --------------------
# Sin dependencias externas (a diferencia del scheduler de settlement): no
# exige postgres ni Wallet/Inventory configurados.
AUCTION_PENDING_CLAIM_EXPIRATION_SCHEDULER_ENABLED=false
AUCTION_PENDING_CLAIM_EXPIRATION_POLL_INTERVAL_MS=60000
AUCTION_PENDING_CLAIM_EXPIRATION_BATCH_SIZE=100
